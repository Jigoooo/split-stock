# split-stock — 환경변수 템플릿
# .env.local 로 복사 후 실제 값을 채워 사용. .env.local 은 git 에 올라가지 않음.
#
# main 프로세스에서 process.env 로 읽어 jjlabsio/korea-stock-mcp 등에 주입.

# 한국 공시 API (https://opendart.fss.or.kr) — 무료 키
DART_API_KEY=

# 한국거래소 API — KRX 승인 키
KRX_API_KEY=

# ECOS API — 한국은행 API
ECOS_API_KEY=

# Naver 검색 Open API — AI 추천 시 최신 뉴스 컨텍스트 (https://developers.naver.com/apps)
# 무료 25,000 호출/일.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
