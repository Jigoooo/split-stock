## pnpm 설정 — Electron 네이티브 모듈 호환
# better-sqlite3 같은 native module이 electron-rebuild에서 찾을 수 있도록 hoist
public-hoist-pattern[]=*electron*
public-hoist-pattern[]=*better-sqlite3*
public-hoist-pattern[]=*esbuild*
public-hoist-pattern[]=@types/*

# Electron dev 바이너리는 mirror 지정 (옵션)
# ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/

# 선택적 의존성 자동 승인 (better-sqlite3 빌드 스크립트 등)
auto-install-peers=true
strict-peer-dependencies=false

# 빌드 스크립트 실행 허용 (native modules)
# pnpm 9+ 는 기본적으로 postinstall 등 스크립트를 막으므로 명시 허용
enable-pre-post-scripts=true
